libepos_a-epos-af-lhcr.o: epos-af-lhcr.f
	$(AM_V_F77)$(F77) $(libepos_a_FFLAGS) $(FFLAGS) -c -o libepos_a-epos-af-lhcr.o `test -f 'epos-af-lhcr.f' || echo '$(srcdir)/'`epos-af-lhcr.f

libepos_a-epos-af-lhcr.obj: epos-af-lhcr.f
	$(AM_V_F77)$(F77) $(libepos_a_FFLAGS) $(FFLAGS) -c -o libepos_a-epos-af-lhcr.obj `if test -f 'epos-af-lhcr.f'; then $(CYGPATH_W) 'epos-af-lhcr.f'; else $(CYGPATH_W) '$(srcdir)/epos-af-lhcr.f'; fi`

