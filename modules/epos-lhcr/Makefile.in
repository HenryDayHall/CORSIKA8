	@: > urqmd34/$(am__dirstamp)
urqmd34/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) urqmd34/$(DEPDIR)
	@: > urqmd34/$(DEPDIR)/$(am__dirstamp)
